NEXT_PUBLIC_APP_URL=

# Cloudflare R2 (photos, wedding card, videos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Comma-separated emails allowed to open /admin
ADMIN_EMAILS=
